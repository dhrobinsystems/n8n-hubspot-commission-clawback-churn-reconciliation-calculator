# =============================================================================
# n8n-hubspot-commission-clawback-churn-reconciliation-calculator :: env template
# -----------------------------------------------------------------------------
# Copy to .env (git-ignored) or set in your n8n host / container / secret
# manager. Every value is a PLACEHOLDER. Never commit real values, and never
# put real employee names, bank or payroll details in this file.
#
# SAFE BY DEFAULT: leaving this file untouched keeps the workflow in
# SANDBOX_MODE: zero API calls, zero files written, zero CRM updates.
# =============================================================================

# ---- n8n runtime --------------------------------------------------------------
# Required so {{ $env.X }} works. If env access is blocked the workflow falls
# back to sandbox defaults instead of failing open.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
# n8n only writes files inside these directories (Read/Write Files node).
# Must include CSV_EXPORT_DIR or the export fails closed.
N8N_RESTRICT_FILE_ACCESS_TO=/home/node/.n8n-files/clawback-exports
GENERIC_TIMEZONE=UTC

# ---- Safety switches (safe defaults shown) ----------------------------------
# Safe-ON: turn off only with an explicit false/0/no/off.
SANDBOX_MODE=true
DRY_RUN=true
BLOCK_EXPORT_ON_PENDING_REVIEW=true
# Safe-OFF: turn on only with an explicit true/1/yes/on.
CSV_EXPORT_ENABLED=false
# Deals are stamped only after a successful CSV export.
HUBSPOT_MUTATIONS_ENABLED=false

# ---- Reconciliation period ----------------------------------------------------
# YYYY-MM (UTC). Empty = previous calendar month. A webhook body {"period":"YYYY-MM"} overrides.
RECONCILIATION_PERIOD=

# ---- Clawback policy ------------------------------------------------------------
CLAWBACK_WINDOW_DAYS=90
# true: churn on day 90 is still inside a 90-day window.
CLAWBACK_WINDOW_INCLUSIVE=true
# contract_start (contract start -> closed-won entry -> close date) or close_date.
CLAWBACK_WINDOW_ANCHOR=contract_start
# linear | tiered | full
CLAWBACK_POLICY=linear
# Used when CLAWBACK_POLICY=tiered: <maxDaysActive>:<rate>, ascending.
CLAWBACK_TIERS=30:1,60:0.5,90:0.25
# Reduce clawbacks by the share of the contract the customer already paid.
CLAWBACK_RETAIN_COLLECTED_CASH=false
# Adjustments below this amount (payroll currency) are not clawed back.
CLAWBACK_MIN_AMOUNT=1.00
# Treat a move from closed-won to closed-lost during the period as churn.
DETECT_CLOSED_LOST_CHURN=true

# ---- Commission basis -----------------------------------------------------------
# recorded_only (fail-closed) or recorded_then_computed (falls back to rates below).
COMMISSION_SOURCE=recorded_only
AE_COMMISSION_RATE=0.10
SDR_COMMISSION_RATE=0.02

# ---- Currency & FX ----------------------------------------------------------------
PAYROLL_CURRENCY=USD
# Used when a deal has no deal_currency_code (single-currency portals).
PORTAL_DEFAULT_CURRENCY=USD
# Units of PAYROLL_CURRENCY per 1 unit of the deal currency. Placeholder values:
# load real rates from your finance-approved source for the period.
FX_RATES=EUR:1.08,GBP:1.27,JPY:0.0067
# Required whenever an FX conversion happens (fail-closed otherwise).
FX_RATES_AS_OF=

# ---- Guards (payroll currency) -----------------------------------------------------
MAX_TOTAL_CLAWBACK=50000
MAX_SINGLE_ADJUSTMENT=15000
REQUIRE_PAYROLL_REF=false
# ownerId:payrollRef pairs (synthetic placeholders shown). Keep real mappings in your secret store.
REP_PAYROLL_REF_MAP=99100001:EMP-SYN-0001,99200001:EMP-SYN-0101

# ---- HubSpot ------------------------------------------------------------------------
HUBSPOT_ACCESS_TOKEN=
# Numeric portal ID. 99000001 is the synthetic sandbox placeholder.
HUBSPOT_PORTAL_ID=99000001
HUBSPOT_API_BASE_URL=https://api.hubapi.com
HUBSPOT_SEARCH_PAGE_SIZE=200
INVOICE_COLLECTION_ENABLED=true
CLOSED_WON_STAGE=closedwon
CLOSED_LOST_STAGE=closedlost
# Deal properties read (custom properties: create them first, see README).
CHURN_DATE_PROPERTY=churn_date
CONTRACT_START_PROPERTY=contract_start_date
SDR_OWNER_PROPERTY=sdr_owner_id
AE_COMMISSION_PAID_PROPERTY=ae_commission_paid
SDR_COMMISSION_PAID_PROPERTY=sdr_commission_paid
CLAWBACK_EXEMPT_PROPERTY=clawback_exempt
# Deal properties written by the stamp (idempotency).
STAMP_STATUS_PROPERTY=clawback_status
STAMP_AE_AMOUNT_PROPERTY=clawback_ae_amount
STAMP_SDR_AMOUNT_PROPERTY=clawback_sdr_amount
STAMP_RECONCILIATION_ID_PROPERTY=clawback_reconciliation_id
STAMP_PROCESSED_AT_PROPERTY=clawback_processed_at

# ---- CSV export ---------------------------------------------------------------------
CSV_EXPORT_DIR=/home/node/.n8n-files/clawback-exports
CSV_INCLUDE_DEAL_NAME=false
CSV_UTF8_BOM=false

# ---- Webhook ------------------------------------------------------------------------
# 16+ random characters. Header x-reconciliation-secret (or ?reconciliation_secret=).
WEBHOOK_SHARED_SECRET=

# ---- Testing ------------------------------------------------------------------------
# Pins "now" (ISO 8601) for reproducible runs.
NOW_OVERRIDE=

